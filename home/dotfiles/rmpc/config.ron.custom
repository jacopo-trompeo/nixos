#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    address: "127.0.0.1:6600",
    lyrics_dir: "/home/jacopo/Music",
    enable_lyrics_hot_reload: true,
    enable_config_hot_reload: true,
    theme: "catppuccin",
    tabs: [
        (
            name: "Queue",
            pane: Split(
                direction: Horizontal,
                panes: [
                    (size: "60%", pane: Pane(Queue)),
                    (size: "40%", pane: Split(
                        direction: Vertical,
                        panes: [
                            (size: "100%", pane: Pane(AlbumArt)),
                            (size: "8", borders: "ALL", border_symbols: Rounded,
                                border_title: [(kind: Text(" Lyrics "), style: (fg: "#b7bdf8"))],
                                border_title_alignment: Center,
                                pane: Pane(Lyrics)),
                        ]
                    )),
                ]
            ),
        ),
        (
            name: "Albums",
            pane: Pane(Albums),
        ),
        (
            name: "Playlists",
            pane: Pane(Playlists),
        ),
        (
            name: "Search",
            pane: Pane(Search),
        ),
    ],
)
